rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product images and uploads: Public can view, only authenticated admins can upload/delete
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default catch-all
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

