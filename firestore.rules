rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Products: Public can view, only authenticated admins can create, modify, or delete
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Store settings & categories: Public can read, only authenticated admins can update
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default catch-all: require authentication
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

